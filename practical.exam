import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3

root = tk.Tk()
root.title("Employee Information System")
root.geometry("700x500")

title_label = tk.Label(
    root,
    text="Employee Information System",
    font=("Arial", 18, "bold")
    )

title_label.pack(pady=10)

input_frame=tk.Frame(root)
input_frame.pack(pady=10)


#NAME
tk.Label(
   input_frame,
   text="Name:"
).grid(row=0,column=0,padx=5,pady=5)

name_entry = tk.Entry(input_frame,width=30)
name_entry.grid(row=0,column=1,padx=5,pady=5)


#AGE
tk.Label(
   input_frame,
   text="Age:"
).grid(row=1,column=0,padx=5,pady=5)

age_entry = tk.Entry(input_frame,width=30)
age_entry.grid(row=1,column=1,padx=5,pady=5)

#POSITION
tk.Label(
   input_frame,
   text="Position:"
).grid(row=2,column=0,padx=5,pady=5)

Position_entry = tk.Entry(input_frame,width=30)
Position_entry.grid(row=2,column=1,padx=5,pady=5)

#BUTTON
button_frame=tk.Frame(root)
button_frame.pack(pady=10)

tk.Button(
    button_frame,
    text="Add",
    width=10,
    command="add_student"
    ).grid(row=0,column=0,padx=5)


tk.Button(
    button_frame,
    text="Update",
    width=10,
    command="add_student"
    ).grid(row=0,column=1,padx=5)


tk.Button(
    button_frame,
    text="Delete",
    width=10,
    command="add_student"
    ).grid(row=0,column=2,padx=5)

tk.Button(
    button_frame,
    text="Clear",
    width=10,
    command="add_student"
    ).grid(row=0,column=3,padx=5)

tk.Button(
    button_frame,
    text="Exit",
    width=10,
    command="add_student"
    ).grid(row=0,column=4,padx=5)



#TABLE
tree=ttk.Treeview(
    root,
    columns=("Name","Age","Position"),
    show="headings"
    )

tree.heading("Name",text="Name")
tree.heading("Age",text="Age")
tree.heading("Position",text="Position")

tree.column("Name",width=200)
tree.column("Age",width=80)
tree.column("Position",width=200)

tree.pack(
    fill="both",
    padx=10,
    pady=10
    )
